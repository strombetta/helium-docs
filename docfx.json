{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "404.md",
          "toc.yml",
          "articles/**/*.{md,yml}",
          "api/**/*.{md,yml}",
          "reference/**/*.{md,yml}",
          "get-started/**/*.{md,yml}"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "staticwebapp.config.json"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/helium"
    ],
    "globalMetadata": {
      "_appName": "Helium documentation",
      "_appTitle": "Helium documentation",
      "_appFooter": "<span>Helium documentation</span><span class=\"helium-footer-links\"><a href=\"https://github.com/strombetta/helium\">Framework</a><a href=\"https://github.com/strombetta/helium-docs\">Documentation repository</a><a href=\"/articles/contributing/index.html\">Contribute</a><a href=\"https://github.com/strombetta/helium-docs/issues/new\">Report an issue</a><a href=\"https://github.com/strombetta/helium/security\">Security</a><a href=\"https://github.com/strombetta/helium-docs/blob/main/LICENSE\">License</a></span>",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableNextArticle": true,
      "_disableContribution": true,
      "_lang": "en"
    }
  }
}
