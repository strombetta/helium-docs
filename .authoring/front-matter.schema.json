{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.helium.local/schemas/front-matter.schema.json",
  "title": "Helium documentation front matter",
  "type": "object",
  "required": [
    "title",
    "description",
    "content_type",
    "area",
    "version",
    "status",
    "last_reviewed"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 240
    },
    "content_type": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "uid": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "level": {
      "type": "string"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "document_status": {
      "type": "string"
    },
    "introduced_in": {
      "type": "string"
    },
    "deprecated_in": {
      "type": "string"
    },
    "replacement": {
      "type": "string"
    },
    "upgrade_from": {
      "type": "string"
    },
    "upgrade_to": {
      "type": "string"
    },
    "change_type": {
      "type": "string"
    },
    "migration_required": {
      "type": "boolean"
    },
    "affected_versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
